# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Database & runtime data
*.db
# WAL sidecars, created alongside the DB now that the engine runs in WAL mode.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/workspaces/

# Node / frontend
node_modules/
dist/
*.local

# Lockfiles from an accidental install at the repo root; the root package.json is
# a dependency-free script shim. (frontend/bun.lock is tracked — hence the leading /.)
/pnpm-lock.yaml
/package-lock.json
/bun.lock

# Electron packaging output
release/

# Frozen backend bundle produced by backend/scripts/build_bundle.sh
backend/bundle/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Per-machine agent settings (never shared)
.claude/settings.local.json
.mcp.local.json
