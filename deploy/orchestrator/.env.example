# --- Identity (Cloudflare Access) — REQUIRED in production ---
# Verify the Cf-Access-Jwt-Assertion header against the team JWKS.
ORCH_ACCESS_TEAM_DOMAIN=plccode.cloudflareaccess.com
ORCH_ACCESS_AUD=<the Access application AUD tag>
# LOCAL DEV ONLY — trust an unverified email header. NEVER set in production.
# ORCH_DEV_TRUST_HEADER=1

# --- Instances ---
ORCH_INSTANCE_IMAGE=ghcr.io/plccode-ai/lursor:latest
ORCH_DOCKER_NETWORK=lursor-net
ORCH_INSTANCE_PORT=8080
ORCH_IDLE_TIMEOUT_S=1200
ORCH_START_TIMEOUT_S=60
ORCH_INSTANCE_MEM_LIMIT=2g
ORCH_INSTANCE_PIDS_LIMIT=512
ORCH_INSTANCE_NANO_CPUS=2000000000
# Stronger isolation once installed on the host (gVisor). Leave empty for runc.
# ORCH_INSTANCE_RUNTIME=runsc

# Shared OpenRouter key handed to every instance (internal MVP; move to per-user
# keys / a key-injecting egress proxy for SaaS — it is exfiltratable by design).
OPENROUTER_API_KEY=

# --- Control API (hub → orchestrator) ---
ORCH_CONTROL_TOKEN=<long random secret shared with the admin app>
